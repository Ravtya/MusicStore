@model List<Track>

@foreach (var track in Model)
{
    var audioUrl = Url.Action("Audio", "Media", new { localSeed = track.LocalSeed, durationSeconds = track.DurationSeconds });
    var imageUrl = Url.Action("Cover", "Media", new { localSeed = track.LocalSeed, album = track.Album, song = track.Song, artist = track.Artist });

    <tr data-bs-toggle="collapse" data-bs-target="#detail-@track.Id">
        <td class="text-muted">@track.Id</td>
        <td class="fw-bold">@track.Song</td>
        <td>@track.Artist</td>
        <td class="text-muted">@track.Album</td>
        <td><span class="badge bg-secondary">@track.Genre</span></td>
    </tr>

    <tr class="collapse" id="detail-@track.Id" data-bs-parent="#trackTableBody">
        <td colspan="5" class="p-0">
            <div class="bg-light px-3 py-4">
                <div class="row g-4 justify-content-center align-items-center text-center">
                    <div class="col-lg-3">
                        <img alt="@track.Album cover" class="rounded d-block mx-auto cover-img"
                             width="200" height="200"
                             data-cover-url="@imageUrl"/>

                        <span class="badge text-bg-danger w-100 mt-2 py-2">
                            <i class="bi bi-heart-fill"></i>
                            @track.Likes.ToString("N0")
                        </span>
                    </div>

                    <div class="col-lg-5">
                        <h4 class="mb-1">@track.Song</h4>
                        <p class="text-muted fs-5 mb-3">@track.Artist</p>

                        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
                            <span class="badge text-bg-light border">@track.Album</span>
                            <span class="badge text-bg-light border">@track.Year</span>
                            <span class="badge text-bg-light border">@track.DurationDisplay</span>
                            <span class="badge text-bg-light border">@track.Genre</span>
                        </div>

                        <div class="bg-white border rounded p-3">
                            <audio controls preload="none" class="w-100">
                                <source src="@audioUrl" type="audio/wav">
                            </audio>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <h6 class="text-uppercase text-muted mb-2">Review</h6>
                        <p class="text-muted fst-italic mb-0 text-break">
                            "@track.Review"
                        </p>
                    </div>
                </div>
            </div>
        </td>
    </tr>
}
